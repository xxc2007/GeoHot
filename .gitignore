# Secrets & local env — never committed. The two *.example templates are the
# tracked sources that scripts/init-env.ts copies from, so they stay in.
# The broad lines below catch the names an operator reaches for when they add a
# second environment (prod.env, secrets.env) or drop a key pair next to the repo.
.env
.env.*
!.env.example
!.env.pipeline.example
.env.ports
*.env
*.pem
*.key
*.p8
id_*
*deploy_key*
secrets*
credentials*

node_modules/
dist/
.cache/
.DS_Store

# Runtime data: embedded PostgreSQL cluster and its working dir
.data/
.pgdata/

# Web production build (regenerated by `npm run build -w @aihot/web`)
apps/web/build/
apps/web/.react-router/
.react-router/

# Font package unpacked to regenerate the report nameplates (docs/customize.md)
package/
fontsource-noto-sans-sc-*.tgz

# --- Agent scratch & process residue -------------------------------------
# An agent's working area must never reach the index: a checkpoint commit once
# swept in .audit-shots/*.html and after-home*.txt, which are throwaway renders
# of pages that the running site already serves. Root-anchored where the residue
# was actually observed; unanchored for the rest.
.brief*/
.brief-*
.audit-shots/
*-scratch/
scratch-*
probe-tmp*
recompose-tmp*
auditq*
/after-*
*.log
*.tmp

# Regenerated by tooling/merge-corpus.mjs on every non-dry-run (see tooling/corpus/README.md)
tooling/corpus/merge-conflicts.md
