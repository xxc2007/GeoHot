[Unit]
Description=GEOHOT web (SSR, 127.0.0.1:3000)
After=network.target geohot-api.service

[Service]
User=geohot
Group=geohot
WorkingDirectory=/opt/geohot/app/apps/web
EnvironmentFile=/opt/geohot/app/.env
Environment=NODE_ENV=production
Environment=AIHOT_ENVIRONMENT=production
Environment=HOME=/opt/geohot
Environment=TZ=Asia/Shanghai
Environment=WEB_HOST=127.0.0.1
MemoryMax=320M
MemorySwapMax=600M
ExecStart=/usr/bin/node --env-file=/opt/geohot/app/.env server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
