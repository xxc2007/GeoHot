# GEOHOT（地理热点）的配置模板。干净克隆里既没有 .env 也没有 .env.pipeline（两者都被 .gitignore 排除），
# 而所有启动命令写的都是 `node --env-file=.env …`——文件不存在时 Node 直接 `.env: not found`、退出码 9。
# 所以第一步是生成它们，别手工复制：
#   npm run env:init                        # 写出 .env 与 .env.pipeline，已存在的文件不覆盖（权限按 600 申请，Windows 上该位只是名义的、实测 666，靠 .gitignore 保护）
#   npm run env:init -- --db-port 5455 --api-port 3299 --web-port 3090 --brain-port 3065
# 它会为下面这些空值键生成真随机串：ADMIN_PASSWORD / SESSION_SECRET / IMG_PROXY_SIGN_SECRET /
# POSTGRES_PASSWORD / INGEST_TOKEN——所以这几行请保持"键名等号后面为空"的写法，脚本的正则匹配不到它们。
# 带 --*-port 时它同时改写 DATABASE_URL、SITE_URL、API_BASE_URL、API_PORT/WEB_PORT、BRAIN_PORT 与
# LLM_BASE_URL，让 migrate/seed/api/web 四条命令不用改就能落在同一组端口上（见 README §3.2、§3.7）。
# 前端只拿到网站地址；所有密钥只在后端。不要把 .env、.env.pipeline 提交到 Git（.gitignore 已排除）。
# 本机开发不需要 Docker、也不需要管理员权限：npm run db:up 用 embedded-postgres 在 .pgdata 起一个
# 持久化的 PostgreSQL 17（默认端口 5433，用户/密码/库都是 geohot），模型调用由本地"编辑大脑"stub 顶替。
#
# ── 本模板里的四类值，别看混 ────────────────────────────────────────────────
#   ① 空值键（ADMIN_PASSWORD= 等）：交给 npm run env:init 生成随机值，生产必须随机。手工 cp 之后
#      保持空值也能起站，但 /admin 进不去（密码空 = 拒登）、/api/ingest/items 一律 401。
#   ② 写死的本机开发值（geohot-dev-*、local-brain）：只在这台机器上成立，不是密钥，抄进生产就是漏洞。
#   ③ 安全阀（false）：开发/测试/演示一律 false；真要跑管道用第二个一次性文件 .env.pipeline 叠上去
#      （README §3.5），永远不要把 .env.pipeline 合并进 .env。模板是 .env.pipeline.example。
#   ④ 端口类键（API_PORT/WEB_PORT/API_HOST/WEB_HOST/API_BASE_URL）：默认值够用就别填；要同时起第二份
#      栈（本机 5433/3055/3199/3000 已经被占，3001 还被一个无关的 Express 占了）才填，或用 --*-port
#      让脚本填。约定也可以写成第三个 env 文件 .env.ports，见文件末尾"端口叠加层"。
# ── 上线前必检：见 scripts/README-ingest.md 的「上线前检查」一节 ──────────────

# ===== 必填 =====

# 网站对外的地址：生成的链接、RSS、分享图、MCP、登录回调都用它。本机浏览就用下面这个。
# 决定 cookie 是否加 Secure：以 https:// 开头才加。本机 http://localhost:3000 就是不带 Secure。
# ⚠️ 生产（NODE_ENV 或 AIHOT_ENVIRONMENT 为 production）不再容忍缺值或 localhost：留空或照抄下面这行会
#   直接拒启（packages/backend/src/config.ts:54-68）。原因是这个回落很安静——canonical、OpenGraph、RSS
#   的 <link>、sitemap 的 <loc>、robots 的 Sitemap 行、security.txt 会全部写成 localhost，而 MCP 的
#   host 锁（apps/api/src/routes/mcp.ts:219）反过来会拒掉真域名。挂在子路径上要连前缀一起写，
#   例如 https://example.com/geohot，而且前缀必须与构建期的 BASE_PATH 一致（deploy/geohot/README-deploy.md §2）。
SITE_URL=http://localhost:3000

# 管理员密码，登录 /admin 用。硬下限 12 位（admin/auth.ts:146 低于 12 直接拒登），
# 生产还额外要求：既没设够长的 ADMIN_PASSWORD 又没配飞书登录时 api 拒绝启动（apps/api/src/main.ts:12）。
# 留空 = 本机根本没有能进后台的身份（DEV_AUTH_ROLE 那条免登录后门已经从本站摘掉，见下面那段警告）。
# npm run env:init 会生成 16 位随机值并在终端打印一次。
ADMIN_PASSWORD=

# 会话相关的签名密钥（≥8 位随机，生产占位值会被拒）。它签的是：
#   ① 飞书扫码登录的 OAuth state（admin/auth.ts:28 secret()）；② 反馈截图的内容名 HMAC（operations/feedback.ts:25）。
# 密码登录本身不用它（会话令牌是随机串、库里只存 SHA-256），但生产 api 启动会强制要求它存在。
SESSION_SECRET=

# 图片代理签名密钥（≥8 位随机）。文中只要有远程图片就会用到：/api/img-proxy 的 HMAC-SHA256 签名
# （media/imgproxy.ts:19），没配就抛错、图片全裂。IMG_PROXY_REQUIRE_SIG=false 可以关掉签名校验，
# 但那等于把代理开放成任意图床，只有本机调试才允许，生产请保持 true（默认）。
IMG_PROXY_SIGN_SECRET=

# 用 Docker 时数据库的密码（数据库不对外开端口，也请用随机字符）。
POSTGRES_PASSWORD=

# 数据库连接串。本机 = scripts/dev-db.ts 起的 embedded PostgreSQL 17（.pgdata，端口 5433）；
# 换自己装的 PostgreSQL 时只改这一行。Docker 版是 postgres://aihot:<POSTGRES_PASSWORD>@db:5432/aihot。
DATABASE_URL=postgres://geohot:geohot@127.0.0.1:5433/geohot

# API 的地址，只由 web 进程在服务端读取（不要暴露给浏览器，也不要写进前端产物）。
API_BASE_URL=http://127.0.0.1:3001

# 模型：任何 OpenAI 兼容接口都可以，所有步骤默认都用它。本机开发指向 tooling/brain-stub.ts（端口 3055）
# 那个"编辑大脑"fixture——它按提示词能力返回人工撰写的地理编辑判断，所以这里的 key 只是占位串。
# 换真服务商时这三项一起改，key 是真密钥：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_API_KEY=sk-…
LLM_BASE_URL=http://127.0.0.1:3055/v1
LLM_API_KEY=local-brain
LLM_MODEL=geohot-editorial-brain
# 服务商特有的请求参数（JSON），比如关掉思考模式：
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 其他服务商的例子：
#   千问 LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智谱 LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash
# 模型能看图就打开（精选条目的标题摘要会参考首图）：
# LLM_VISION=true
# 服务不支持 JSON 模式（response_format）时关掉：
# LLM_JSON_MODE=false

# ===== 安全阀（开发、测试和演示时保持关闭，见 AGENTS.md）=====
# 关掉就不抓信源（COLLECT_ENABLED）、不调模型（MODEL_CALLS_ENABLED 与 EMBEDDINGS_ENABLED）；
# 推送、告警和 IndexNow 提交同理。要真跑一次管道，叠 .env.pipeline，不要写进这里——
# npm test 会继承 .env，在 .env 里开阀等于让测试去打外部服务。
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
# 向量召回（归组时多一路线索），和 EMBEDDING_* 一起用；没有 key 时保持 false。
EMBEDDINGS_ENABLED=false
# 精选推送到飞书群 / 告警与反馈转发到内部飞书群。
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
# 每天把新页面提交给 IndexNow（Bing 等）。
INDEXNOW_SUBMIT_ENABLED=false

# ===== 后台登录：本机演示也走密码，不用开发替身 =====
# ⚠️⚠️ DEV_AUTH_ROLE 保持注释状态，这就是"能不能带着它交付"的答案。⚠️⚠️
# 它一旦设成 admin（且 AIHOT_ENVIRONMENT/NODE_ENV 不是 production），后台就不再需要登录：
#   packages/backend/src/admin/auth.ts:166 直接发一个 csrf:"dev" 的替身身份，
#   apps/api/src/routes/admin-auth.ts:53 的写操作校验只比对那个常量 "dev"。
# 实测后果：不带任何 cookie，GET /api/admin/sources=200、POST/PATCH 带 x-csrf-token: dev 就能写。
# assertProductionSecrets（config.ts:127）会在 NODE_ENV=production 时看到任何 DEV_AUTH_* 键就拒绝启动，
# 但那道闸门不会替你把开关摘掉——带着它演示完就交付，等于把敞开的新站发出去。
# 需要免登录跑脚本时，用 curl 先登录拿 cookie（用法见 scripts/README-ingest.md），别开这个开关。
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin   # 替身身份在后台侧栏显示的名字

# ===== 选填：让事件归组更准 =====
# 向量召回：任何 OpenAI 兼容的 /embeddings 接口。不填也能跑，只是归组少一路线索。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536   # 向量维度；换模型时要对上，否则相似度没有意义
# 或者只填阿里云百炼的 key，就用 text-embedding-v4：
# DASHSCOPE_API_KEY=

# ===== 选填：每一步单独换模型 =====
# 默认每一步都用上面的 LLM_*。想让某一步用别家，填预设名（需要对应的 key）：
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL  MONITOR_MODEL
# 预设名与需要的 key：
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 上游 AIHOT 自己的分工（仅供参考；本站这两个 AI 模块已经关掉，见 industry/features.ts）：
#   PREFILTER_MODEL=qwen3.7-flash  SCORE_MODEL=glm-5.3-flash-selection  UNDERSTAND_MODEL=glm-5.3-flash
#   SUMMARIZE_MODEL=deepseek-flash  STRUCTURE_MODEL=qwen3.8-flash  GROUP_MODEL=deepseek-flash
#   GROUP_REVIEW_MODEL=mimo-v2.6-flash  DIGEST_MODEL=deepseek-flash  REPORT_MODEL=deepseek-flash

# ===== 选填：付费的采集服务（按请求计费，有预算熔断与回执，在后台"设置"里调）=====
# X（推特）账号：SocialData（不填就不运行；本站 codexResetMonitor=false，用不到）
# SOCIALDATA_API_KEY=
# 微信公众号：极致了（Dajiala）
# DAJIALA_KEY=
# 抓不到正文时用浏览器渲染兜底：Jina Reader
# JINA_API_KEY=
# 读 GitHub 接口类信源时提高配额（只读 token）
# GITHUB_TOKEN=

# ===== 选填：飞书（本机开发用不到，全部留空即可）=====
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 用飞书账号登录后台（可选，和管理员密码并存；开启后 SESSION_SECRET 才真的用于签 state）：
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 选填：外部脚本往站里推内容（POST /api/ingest/items）=====
# 规则写在 apps/api/src/routes/ingest.ts:9-19，四条都会让接口整体 401（不是 403，不区分原因）：
#   ① 空值；② 少于 16 位；③ 整串等于占位词 changeme/change-me/placeholder/xxx+/todo/test/dev/your[-_]?token*；
#   ④ 请求头不是 `Authorization: Bearer <token>`（大小写不敏感，恒定时间比较）。
# 生成（Node 自带，无需 openssl）：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 另有每 IP 每分钟 10 次、单请求 ≤50 条（超出 413）的限制；改完必须重启 api。
# 本机演示用的已验证 curl 见 scripts/README-ingest.md；生产请换随机串并当成密钥管理。
# 保持空值 = 这个接口一直 401（人工投递用不了，别的都不受影响）。npm run env:init 会填一个 48 位十六进制
# 随机值并把这一行取消注释；手工 cp 的话就自己填。改完必须重启 api 才生效。
INGEST_TOKEN=

# ===== 选填：其他 =====
# 抓取海外信源要走代理时（比如服务器在中国大陆）；只影响外发请求的目标地址。
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 前面有 Caddy 或 Nginx 这类反向代理时设为 true，访客地址才从代理的 X-Forwarded-For 里读；
# 网站直接对外时保持 false，免得有人伪造地址绕过登录次数和反馈的限制。
# 读它的是两个进程，写法一致（只有字符串 true 算开，缺省一律当 false）：
#   web —— apps/web/server.ts:20，决定转发给 api 的 X-Forwarded-For / X-Real-IP 填哪个地址；
#   api —— apps/api/src/app.ts:28 的 trustProxy，决定 req.ip 取 XFF 的最后一项还是这条连接自己的地址，
#          于是登录限流（每地址 10 次、全局 15 分钟 50 次，apps/api/src/routes/admin-auth.ts:26-41）
#          和反馈限流到底按谁计数。
# 两个都要开：只开 web 时 api 仍按 socket 地址算，反代同机时那个地址恒为 127.0.0.1，全体访客共用一份
# 额度（谁都可能被别人挤进"尝试过多"）；只开 api 而不开 web 则是 web 把 127.0.0.1 转发过去，同样失真。
# 历史一句：2026-10 之前这一行只管 web，api 的 trustProxy 是写死的 true——那时"false 保护 api 限流"
# 这句话并不成立，现在成立了。
TRUST_PROXY=false
# 允许后端访问内网/回环地址（本机把"编辑大脑"stub 当服务时不需要，它已经是 http://127.0.0.1）。
# 生产环境带着它 = assertProductionSecrets 直接拒绝启动（config.ts:135），别开到线上。
# ALLOW_PRIVATE_NETWORK_FETCH=false
# MCP 只接受发给 SITE_URL 域名（和 localhost）的请求；还有别的访问域名时，逗号分隔写在这里：
# MCP_ALLOWED_HOSTS=
# 网站多久没有新内容就算"停止收录"并告警（分钟，默认 360）：
# ALERT_QUIET_MINUTES=360
# IndexNow 的 key，32 位十六进制，自己生成（INDEXNOW_SUBMIT_ENABLED=true 时才用到）：
# INDEXNOW_KEY=
# 数据库每天备份到 S3 兼容的对象存储（腾讯云 COS、AWS S3、阿里云 OSS……），04:10 跑。
# ⚠️ 本机的 embedded-postgres 没有 pg_dump，这条链路只适用于 Docker 版；
#    本交付的实用备份办法见 scripts/README-ingest.md 的「上线前检查」。
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 图片缓存、导出文件、日报存档的目录（默认 <仓库根>/.data，已 gitignore）：
# AIHOT_DATA_DIR=

# ===== 上游遗留的 AIHOT_* 前缀：包名与变量名保留，面向用户的字符串一律 GEOHOT/地理热点 =====
# 简报 §2.6：目录名 industry/ 与 npm workspace 名 @aihot/industry 不改（102 处 import + 5 处硬编码路径）。
# 同理，这几个 AIHOT_* 环境变量名也不能重命名——改了就是静默失效，代码里读的是这些键名：
#   AIHOT_ENVIRONMENT  部署名，出现在告警里；development / production。
#                    ⚠️ 拒启检查比的是这个值 *和* NODE_ENV：DEV_AUTH_* 的闸门看 config.environmentName
#                       （= AIHOT_ENVIRONMENT），而 assertProductionSecrets 看 NODE_ENV===production。
#                       只把 AIHOT_ENVIRONMENT 改成 production 而 NODE_ENV 留 development，是关不掉那道闸的。
AIHOT_ENVIRONMENT=development
#   AIHOT_DATA_DIR     上面那个数据目录。
#   AIHOT_CREDENTIALS_DIR  按组拆分的 dotenv 目录（models.env / collectors.env / integrations.env / auth.env），
#                    环境变量优先于文件；正常部署全写在 .env，这里留空。
# AIHOT_CREDENTIALS_DIR=
#   AIHOT_RELEASE      版本标记，出现在健康检查和心跳里（默认 dev），纯观测用、不是密钥。
# AIHOT_RELEASE=
# 另有一批 aihot_* 前缀的浏览器/数据库标识，同样不建议改名（改了会丢老数据）：
#   cookie：aihot_admin（会话）、aihot_oauth_state（飞书 state）；localStorage 键前缀 aihot_。
#   MCP 工具名 geohot_*（已换），公开 API 路径 /api/v1/*（不含品牌）。

# ===== 不用 Docker、直接在本机跑时才需要 =====
# API 与 web 的监听端口与绑定地址（默认就是这些值，需要改时才填）。
# ⚠️ 本机的真实情况是这几个默认值全被占了：3000 是本站在跑的 web，3001 是一个无关的 Express 应用
# （不是本站），本站的 api 实际跑在 3199、worker 同栈，数据库 5433、stub 3055。第二个人（或第二份克隆）
# 想并肩跑就换一组空闲端口：`npm run env:init -- --db-port 5455 --api-port 3299 --web-port 3090
# --brain-port 3065`，它会把下面这几行连同 DATABASE_URL / SITE_URL / API_BASE_URL / LLM_BASE_URL 一起写好。
# API_PORT=3001
# API_HOST=127.0.0.1
# WEB_PORT=3000
# WEB_HOST=127.0.0.1
# 数据库端口有第二处：scripts/dev-db.ts 的 --port（或 DEV_DB_PORT），默认 5433。它和 DATABASE_URL 里的
# 端口必须一致——env:init 的 --db-port 会同时改两处，dev-db 在两边不一致时会打印 WARNING。
# DEV_DB_PORT=5433
# 端口叠加层（可选，同样被 .gitignore 排除，键名就是上面这五个）：本机现在用 .env.ports 记着
# API_PORT=3199 / WEB_PORT=3000 / API_BASE_URL=http://127.0.0.1:3199，启动时叠第三层：
#   node --env-file=.env --env-file=.env.pipeline --env-file=.env.ports apps/api/src/main.ts
# 用 --*-port 让 env:init 直接写进 .env 也可以，两种办法别混用（后面的 env-file 覆盖前面的）。
# Node 运行时环境：production 会触发 assertProductionSecrets（缺密钥/占位值/DEV_AUTH_*/
# ALLOW_PRIVATE_NETWORK_FETCH 一律拒启），并把 AIHOT_ENVIRONMENT 的默认值改成 production。
NODE_ENV=development
# 日志级别（fastify）：fatal / error / warn / info / debug / trace。
# LOG_LEVEL=info
# worker 的并发：同时抓多少个信源、同时分析多少篇。本机开发用小值，别一次点几十路外网请求。
FETCH_CONCURRENCY=2
ANALYZE_CONCURRENCY=2
# 数据库连接池上限（默认 10）。
# DATABASE_POOL_MAX=10
# 精选条目发布后延迟多久对读者可见（秒，默认 180），用于避开"发布即索引"的时间毛刺。
# SELECTED_VISIBLE_AFTER_SECONDS=180

# ===== 时区：跑采集与日报才有意义，但值很小 =====
# Node/进程本地时区。json_list 类信源（地震台网速报、中央气象台预警）返回的是**不带时区**的本地时间
# 字符串，packages/backend/src/sources/json-list.ts:52 用 new Date(str) 解释它，按进程时区走：
# 不设这一条、机器又在 UTC 时区（Docker 镜像、CI、多数云主机）时，采集回来的 published_at 会整体
# 差 8 小时——热度按错的时间衰减、该进今天的条目被算成"昨天"、08:00 出刊的日报日期也跟着偏。
# 本站按 Asia/Shanghai 运营（日报 08:00、周报周一 10:00、月报每月 1 日 10:30 都是这个时区）。
# 只在浏览与测试时无所谓；.env.pipeline 里带着这一行，跑管道时叠上即可。
# TZ=Asia/Shanghai

# ===== 只在跑本机工具/脚本时才用得到（正常部署全部留空）=====
# 一次性采集：只跑这些源（逗号分隔的 sourceId），并跳过 Jina 兜底：
#   node --env-file=.env --env-file=.env.pipeline scripts/collect.ts <sourceId…>
# COLLECT_KINDS=  COLLECT_SKIP_JINA=  JINA_BODY_FALLBACK=
# cron.sources.schedule 每分钟的批大小（默认 40；一次性验证建议压到 1，见 .env.pipeline）。
# FETCH_SCHEDULE_BATCH=1
# "编辑大脑"stub 自身的开关（tooling/brain-stub.ts）：端口、提示词与 fixture 目录、兜底分、日志大小。
# ⚠️ `npm run brain` 就是 `node tooling/brain-stub.ts`，不读任何 env 文件，所以换 stub 端口要么走 shell
#   前缀（BRAIN_PORT=3065 npm run brain），要么显式叠文件（node --env-file=.env tooling/brain-stub.ts）。
#   env:init 的 --brain-port 会把 BRAIN_PORT 与 LLM_BASE_URL 一起写进 .env 和 .env.pipeline。
# BRAIN_PORT=3055  BRAIN_PROMPTS_DIR=  BRAIN_FIXTURES_DIR=  BRAIN_SCORE_DEFAULT=  BRAIN_UNDERSTAND_ITEM_TYPE=
# BRAIN_GROUP_DEFAULT=  BRAIN_GROUP_LEXICAL_MIN=  BRAIN_SUMMARIZE_DEFAULT=  BRAIN_LOG_SIZE=  AIHOT_CHANGELOG_FILE=
# 搜索/归组的本地并发上限（默认值够用；只在压测时才动）。LOCAL_ROUTER_URL=  SEARCH_MAX_CONCURRENCY=  SEARCH_MAX_QUEUE=

# ===== 用 docker compose --profile https 时 =====
# SITE_DOMAIN=example.com
