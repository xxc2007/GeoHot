# ============================================================================
# GEOHOT（地理热点）一次性管道运行环境模板。复制成 .env.pipeline 再改，或直接
#   npm run env:init        （它一次写出 .env 和 .env.pipeline 两个文件）
# 这个文件只用于"让管道真跑一次"：叠在 .env 之上，绝不合并进 .env，绝不留给日常浏览演示用。
#   node --env-file=.env --env-file=.env.pipeline apps/api/src/main.ts
#   node --env-file=.env --env-file=.env.pipeline apps/worker/src/main.ts
# 它已被 .gitignore 的 `.env.*` 规则排除（`git check-ignore -v .env.pipeline` 可验证），
# 所以干净克隆里根本没有这个文件——这就是 README §3.2 要求先跑 env:init 的原因。
#
# ⚠️ 这里刻意没有 DEV_AUTH_ROLE。
#   它一旦出现在 .env 或 .env.pipeline 里（且 AIHOT_ENVIRONMENT/NODE_ENV 不是 production），本栈所有
#   /api/admin/* 就都不需要登录，含写操作：packages/backend/src/admin/auth.ts:166 发一个 csrf:"dev"
#   的替身身份，apps/api/src/routes/admin-auth.ts:53 只比对那个常量。进后台请用 .env 里的
#   ADMIN_PASSWORD 在 http://localhost:3000/admin/login 登录。锁死与验证方法见 README §11。
# ============================================================================

# ===== 两个阀门：只有在这里才打开 =====
# COLLECT_ENABLED=true 才会真的去抓信源；MODEL_CALLS_ENABLED=true 才会调"模型"（本站是本地 stub，
# 一次也不产生账单）。测试继承的是 .env，不是这个文件，所以这两个阀在 .env 里必须一律 false。
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== "编辑大脑"stub 指针（tooling/brain-stub.ts，npm run brain，默认只听 127.0.0.1:3055）=====
# 没有真 LLM Key 时的做法：这三行让 prefilter → 两次打分 → understand → structure → 归组 → 成刊
# 全部走真实代码路径，判断由 tooling/fixtures/*.jsonl 里人工写的 fixture 提供。
# LLM_API_KEY 是占位串，stub 不看它。--brain-port 换端口时 npm run env:init 会同步改写 LLM_BASE_URL。
LLM_BASE_URL=http://127.0.0.1:3055/v1
LLM_API_KEY=local-brain
LLM_MODEL=geohot-editorial-brain

# ===== 其余安全阀：在这里也写死 false，防止上面两个 OPEN 被误读成"全都开" =====
EMBEDDINGS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false

# ===== 采集的操作参数（不是安全阀）=====
# 必须设。json_list 类信源（中国地震台网速报等）给的是无时区的本地时间字符串，
# packages/backend/src/sources/json-list.ts:52 按进程本地时区解释它：不设这一条，Node 会用系统时区，
# 采集回来的 published_at 整体差 8 小时，热度窗口与"今天"的日报日期跟着一起错。
TZ=Asia/Shanghai
# cron.sources.schedule 每分钟的批大小（默认 40）。手工只拉选定子集时压到 1，
# 免得启动那一分钟把 44 个源全灌进队列（packages/backend/src/sources/collect.ts:322）。
FETCH_SCHEDULE_BATCH=1
