[Unit]
Description=GEOHOT worker (pg-boss queues + schedules; SINGLE INSTANCE ONLY)
After=network.target postgresql.service geohot-brain.service

[Service]
User=geohot
Group=geohot
WorkingDirectory=/opt/geohot/app
EnvironmentFile=/opt/geohot/app/.env
Environment=NODE_ENV=production
Environment=AIHOT_ENVIRONMENT=production
Environment=HOME=/opt/geohot
Environment=TZ=Asia/Shanghai

MemoryMax=240M
MemorySwapMax=600M
ExecStart=/usr/bin/node --env-file=.env apps/worker/src/main.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
