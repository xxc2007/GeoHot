[Unit]
Description=GeoHot InstaBox hold-awake (free plan pauses after 30 idle minutes; the executor only connects out)
Documentation=file:///opt/geohot/bin/instabox-hold.mjs
After=network-online.target
Wants=network-online.target
# 常驻进程最怕被启动频率上限打死（box 上就踩过 StartLimitBurst），这里直接关掉上限
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Environment=INSTABOX_MACHINE=m_agq566xboeglgwufg5qvn7qxle
Environment=INSTABOX_TOKEN_FILE=/etc/geohot/instabox-token
# 空闲暂停是 30 分钟：入向活动必须比它密得多，留出三倍余量
Environment=INSTABOX_ACTIVE_MS=300000
ExecStart=/usr/bin/node /opt/geohot/bin/instabox-hold.mjs
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle
MemoryMax=96M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
