[Unit]
Description=geohot content executor (analysis on this node)
After=geohot-exec-db-tunnel.service
Requires=geohot-exec-db-tunnel.service

[Service]
User=geohot
WorkingDirectory=/home/geohot/geohot
EnvironmentFile=/opt/geohot-exec/.env
ExecStart=/usr/local/node/bin/node --env-file=/opt/geohot-exec/.env apps/worker/src/main.ts
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45
MemoryHigh=900M
MemoryMax=1100M
MemorySwapMax=1024M

[Install]
WantedBy=multi-user.target
