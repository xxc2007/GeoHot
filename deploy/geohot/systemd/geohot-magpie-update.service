[Unit]
Description=Reader-first idle Magpie update with owned workflow recovery
After=network-online.target
[Service]
Type=oneshot
Environment=TZ=Asia/Shanghai
ExecStart=/bin/bash /opt/geohot/app/deploy/geohot/magpie-update.sh
ExecStopPost=/usr/bin/python3 /opt/geohot/app/deploy/geohot/magpie-maintenance.py --recover
TimeoutStartSec=20min
Nice=19
IOSchedulingClass=idle
CPUQuota=30%
CPUWeight=10
IOWeight=10
MemoryMax=160M
UMask=0077
