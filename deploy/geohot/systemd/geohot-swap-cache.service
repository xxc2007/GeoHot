[Unit]
Description=Bounded GEOHOT host compressed swap cache
After=systemd-modules-load.service
Before=geohot-worker.service geohot-content-executor.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/geohot/app/deploy/geohot/enable-swap-cache.sh
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
