    {
      "sourceId": "intl-loc-worlds-revealed",
      "mode": "months",
      "urlTemplate": "https://blogs.loc.gov/maps/{month}/",
      "config": {
        "parseMode": "html",
        "itemSelector": "article:has(h2 a[rel='bookmark'])",
        "linkSelector": "h2 a[rel='bookmark']",
        "titleSelector": "h2",
        "publishedAtSelector": "time",
        "allowUrlPrefixes": [
          "https://blogs.loc.gov/maps/"
        ],
        "denyUrlPrefixes": [
          "https://blogs.loc.gov/maps/category/",
          "https://blogs.loc.gov/maps/author/"
        ]
      }
    },
