{
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  "exclude": [
    "app/routes/leaderboard.tsx",
    "app/routes/leaderboard-model.tsx",
    "app/routes/leaderboard-source.tsx",
    "app/routes/leaderboard-sources.tsx",
    "app/routes/leaderboard-rules.tsx",
    "app/routes/leaderboard-boards.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}
