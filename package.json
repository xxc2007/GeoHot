{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "env:init": "node scripts/init-env.ts",
    "db:up": "node scripts/dev-db.ts",
    "db:down": "node scripts/dev-db-down.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed:curated": "node --env-file-if-exists=.env scripts/seed-curated.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "brain": "node tooling/brain-stub.ts",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && npm run typecheck -w @aihot/web",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "embedded-postgres": "^17.10.0-beta.17",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
